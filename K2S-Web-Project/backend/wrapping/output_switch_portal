<script>
    function changeLanguage(language) {
        const xhr = new XMLHttpRequest();
        xhr.open('POST', document.getElementById('languageForm').action, true);
        xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        xhr.onreadystatechange = function () {
            if (xhr.readyState === 4) {
                if (xhr.status === 200) {
                    const response = JSON.parse(xhr.responseText);
                    if (response.status === 'success') {
                        // Handle pesan sukses jika diperlukan
                        console.log(response.message);
                        // Reload halaman setelah mengganti bahasa
                        window.location.reload();
                    }
                } else {
                    // Handle kesalahan jika diperlukan
                    console.log('Error changing language');
                }
            }
        };
        xhr.send('language=' + language);
    }

    function showAlert() {
        Swal.fire({
            title: 'Failed!',
            text: 'Token Gagal Di Generate.',
            icon: 'error',
            confirmButtonText: 'OK'
        });
    }
</script>
