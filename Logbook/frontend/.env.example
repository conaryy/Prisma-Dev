# Untuk local dev, arahkan ke backend logbook.
VITE_LOGBOOK_API_BASE_URL=http://localhost:3100/api/v1

# URL auth portal pusat (redirect jika token belum ada)
VITE_AUTH_PORTAL_URL=https://prisma.ryvidia.my.id/login

# Aktifkan SSO OIDC
VITE_SSO_ENABLED=true
VITE_SSO_AUTH_BASE_URL=http://localhost:4000
VITE_SSO_AUTHORIZE_URL=http://localhost:4000/oauth/authorize
VITE_SSO_TOKEN_URL=http://localhost:4000/oauth/token
VITE_SSO_LOGOUT_URL=http://localhost:4000/auth/logout
VITE_SSO_CLIENT_ID=logbook-web
VITE_SSO_CLIENT_SECRET=dev-secret-logbook
VITE_SSO_REDIRECT_URI=http://localhost:5175/auth/callback
VITE_SSO_SCOPE=openid profile email
