generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TowerLogbookEntry {
  id            String   @id @default(cuid())
  entryNo       Int
  entryDate     DateTime
  entryTime     String
  operationType String
  facility      String
  callSign      String
  description   String
  sourceType    String   @default("manual")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([entryDate, entryTime])
  @@index([entryNo])
  @@map("tower_logbook_entries")
}

model AppLogbookEntry {
  id            String   @id @default(cuid())
  entryNo       Int
  entryDate     DateTime
  entryTime     String
  operationType String
  facility      String
  callSign      String
  description   String
  sourceType    String   @default("manual")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([entryDate, entryTime])
  @@index([entryNo])
  @@map("app_logbook_entries")
}

model TeknikLogbookEntry {
  id               String   @id @default(cuid())
  entryNo          Int
  entryDate        DateTime
  entryTime        String
  equipment        String
  frequencySection String
  incident         String
  sourceType       String   @default("manual")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([entryDate, entryTime])
  @@index([entryNo])
  @@map("teknik_logbook_entries")
}
