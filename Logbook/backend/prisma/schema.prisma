generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TowerLogbookEntry {
  id            String   @id @default(cuid())
  entryNo       Int      @map("entry_no")
  entryDate     DateTime @map("entry_date")
  entryTime     String   @map("entry_time")
  operationType String   @map("operation_type")
  facility      String
  callSign      String   @map("call_sign")
  description   String
  sourceType    String   @default("manual") @map("source_type")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([entryDate, entryTime])
  @@index([entryNo])
  @@map("tower_logbook_entries")
}

model AppLogbookEntry {
  id            String   @id @default(cuid())
  entryNo       Int      @map("entry_no")
  entryDate     DateTime @map("entry_date")
  entryTime     String   @map("entry_time")
  operationType String   @map("operation_type")
  facility      String
  callSign      String   @map("call_sign")
  description   String
  sourceType    String   @default("manual") @map("source_type")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([entryDate, entryTime])
  @@index([entryNo])
  @@map("app_logbook_entries")
}

model TeknikLogbookEntry {
  id               String   @id @default(cuid())
  entryNo          Int      @map("entry_no")
  entryDate        DateTime @map("entry_date")
  entryTime        String   @map("entry_time")
  equipment        String
  frequencySection String   @map("frequency_section")
  incident         String
  importBatchId    String?  @map("import_batch_id")
  sourceType       String   @default("manual") @map("source_type")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([entryDate, entryTime])
  @@index([entryNo])
  @@index([importBatchId])
  @@map("teknik_logbook_entries")
}
