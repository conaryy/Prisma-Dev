generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TowerLogbookEntry {
  id            String   @id @default(cuid())
  entryNo       Int      @map("entry_no")
  entryDate     DateTime @map("entry_date")
  entryTime     String   @map("entry_time")
  operationType String   @map("operation_type")
  facility      String
  callSign      String   @map("call_sign")
  description   String
  importBatchId String?  @map("import_batch_id")
  sourceType    String   @default("manual") @map("source_type")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([entryDate, entryTime])
  @@index([entryNo])
  @@index([importBatchId])
  @@map("tower_logbook_entries")
}

model AppLogbookEntry {
  id            String   @id @default(cuid())
  entryNo       Int      @map("entry_no")
  entryDate     DateTime @map("entry_date")
  entryTime     String   @map("entry_time")
  operationType String   @map("operation_type")
  facility      String
  callSign      String   @map("call_sign")
  description   String
  importBatchId String?  @map("import_batch_id")
  sourceType    String   @default("manual") @map("source_type")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([entryDate, entryTime])
  @@index([entryNo])
  @@index([importBatchId])
  @@map("app_logbook_entries")
}

model TeknikLogbookEntry {
  id               String   @id @default(cuid())
  entryNo          Int      @map("entry_no")
  entryDate        DateTime @map("entry_date")
  entryTime        String   @map("entry_time")
  equipment        String
  frequencySection String   @map("frequency_section")
  incident         String
  importBatchId    String?  @map("import_batch_id")
  sourceType       String   @default("manual") @map("source_type")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([entryDate, entryTime])
  @@index([entryNo])
  @@index([importBatchId])
  @@map("teknik_logbook_entries")
}

model LogbookImportBatch {
  id             String    @id @default(cuid())
  sourceCategory String    @map("source_category")
  sourcePeriod   String?   @map("source_period")
  sourceFileName String    @map("source_file_name")
  status         String    @default("pending")
  totalRows      Int       @default(0) @map("total_rows")
  validRows      Int       @default(0) @map("valid_rows")
  invalidRows    Int       @default(0) @map("invalid_rows")
  sheetName      String?   @map("sheet_name")
  importedBy     String    @map("imported_by")
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")
  notes          String?

  @@map("logbook_import_batches")
}

model LogbookImportSource {
  id           String  @id @default(cuid())
  batchId      String  @map("batch_id")
  sheetName    String  @map("sheet_name")
  rowNumber    Int     @map("row_number")
  rawDateValue String? @map("raw_date_value")
  rawTimeValue String? @map("raw_time_value")
  rawPayload   String  @db.Text @map("raw_payload")

  @@index([batchId])
  @@map("logbook_import_sources")
}

model LogbookImportError {
  id           String  @id @default(cuid())
  batchId      String  @map("batch_id")
  sheetName    String  @map("sheet_name")
  rowNumber    Int     @map("row_number")
  fieldName    String  @map("field_name")
  errorCode    String  @map("error_code")
  errorMessage String  @map("error_message")
  rawPayload   String  @db.Text @map("raw_payload")

  @@index([batchId])
  @@map("logbook_import_errors")
}

model LogbookAuditTrail {
  id         String   @id @default(cuid())
  actorId    String   @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  batchId    String?  @map("batch_id")
  metadata   String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([batchId])
  @@index([targetType, targetId])
  @@map("logbook_audit_trails")
}

model LogbookIntegrityRecord {
  id         String    @id @default(cuid())
  batchId    String?   @map("batch_id")
  recordType String    @map("record_type")
  recordRef  String?   @map("record_ref")
  hashType   String    @map("hash_type")
  hashValue  String    @map("hash_value")
  anchored   Boolean   @default(false)
  anchoredAt DateTime? @map("anchored_at")
  anchorRef  String?   @map("anchor_ref")

  @@index([batchId])
  @@index([recordType, recordRef])
  @@map("logbook_integrity_records")
}
