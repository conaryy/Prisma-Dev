PORT=3000
EMBEDDING_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding
CHAT_PROVIDER=ollama
OLLAMA_CHAT_MODEL=qwen2.5:3b
CHAT_STRUCTURED_LIMIT=100
CHAT_CHUNK_SIZE=20
CHAT_CHUNK_THRESHOLD=25
SEARCH_LEXICAL_EXACT_BOOST=0.20
SEARCH_LEXICAL_PARTIAL_BOOST=0.08
SEARCH_LEXICAL_OVERLAP_BOOST=0.18
SEARCH_LEXICAL_PARTIAL_MIN_LENGTH=12
SEARCH_LEXICAL_MODE_AUTO=true
SEARCH_LEXICAL_STRING_HEAVY_MULTIPLIER=1.8
SEARCH_LEXICAL_NATURAL_MULTIPLIER=1.0
GEMINI_API_KEY=your_gemini_api_key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash
DATABASE_URL=postgresql://postgres:password@localhost:5432/your_database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=logbook_entries
