PORT=3105
CORS_ALLOW_ORIGINS=http://localhost:5175,https://logbook.prisma.ryvidia.my.id

# PostgreSQL (non-blockchain primary database)
DATABASE_URL=postgresql://logbook:logbook_password@localhost:5432/logbook?schema=public

# SSO settings (pakai nilai yang sama dari .env.central saat mode hybrid/sso)
SSO_ISSUER=
SSO_AUDIENCE=
SSO_JWKS_URL=
SSO_CLIENT_ID=

# Semantic search / Qdrant indexing
SEMANTIC_SEARCH_ENABLED=false
SEMANTIC_SEARCH_EMBEDDING_PROVIDER=ollama
SEMANTIC_SEARCH_OLLAMA_URL=http://127.0.0.1:11434
SEMANTIC_SEARCH_OLLAMA_EMBEDDING_MODEL=qwen3-embedding
SEMANTIC_SEARCH_GEMINI_API_KEY=
SEMANTIC_SEARCH_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
SEMANTIC_SEARCH_QDRANT_URL=http://localhost:6333
SEMANTIC_SEARCH_QDRANT_API_KEY=
SEMANTIC_SEARCH_QDRANT_COLLECTION=logbook_entries
SEMANTIC_SEARCH_LEXICAL_EXACT_BOOST=0.2
SEMANTIC_SEARCH_LEXICAL_PARTIAL_BOOST=0.08
SEMANTIC_SEARCH_LEXICAL_OVERLAP_BOOST=0.18
SEMANTIC_SEARCH_LEXICAL_PARTIAL_MIN_LENGTH=12
SEMANTIC_SEARCH_LEXICAL_MODE_AUTO=true
SEMANTIC_SEARCH_LEXICAL_STRING_HEAVY_MULTIPLIER=1.8
SEMANTIC_SEARCH_LEXICAL_NATURAL_MULTIPLIER=1.0
SEMANTIC_SEED_BATCH_SIZE=25
SEMANTIC_SEED_STATE_FILE=.semantic-seed-state.json
