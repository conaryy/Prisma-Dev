PORT=3100
CORS_ALLOW_ORIGINS=http://localhost:5177,https://logbook.prisma.ryvidia.my.id

# PostgreSQL (non-blockchain primary database)
DATABASE_URL=postgresql://logbook:logbook_password@localhost:5432/logbook?schema=public

# SSO settings (pakai nilai yang sama dari .env.central saat mode hybrid/sso)
SSO_ISSUER=
SSO_AUDIENCE=
SSO_JWKS_URL=
SSO_CLIENT_ID=
