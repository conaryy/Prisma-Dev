# Internal/LAN deploy env.
# Copy to .env.central.internal, then replace every 192.168.1.10 with the server's LAN IP.
# Run with:
# docker compose --env-file .env.central.internal -f docker-compose.central.yml -f docker-compose.internal.yml up -d --build

INTERNAL_SERVER_IP=192.168.1.10

APP_NAME=K2S
APP_ENV=local
APP_DEBUG=true
APP_KEY=base64:REPLACE_WITH_php_artisan_key_generate_show

K2S_FRONTEND_PORT=5173
K2S_BACKEND_PORT=8000
AUTH_FRONTEND_PORT=5174
AUTH_BACKEND_PORT=3104
LOGBOOK_FRONTEND_PORT=5175
LOGBOOK_BACKEND_PORT=3105
K3_PORT=3106
KEAMANAN_PORT=3107

BACKEND_APP_URL=http://192.168.1.10:8000
VITE_API_BASE_URL=http://192.168.1.10:8000

AUTH_BASE_URL=http://192.168.1.10:3104
AUTH_ISSUER=http://192.168.1.10:3104
AUTH_PORTAL_URL=http://192.168.1.10:5174
AUTH_LOGIN_UI_URL=http://192.168.1.10:5174/login
AUTH_JWK_HOST_PATH=./Auth/backend/data/jwks-private.json
AUTH_JWK_PATH=/run/secrets/auth-jwk.json
AUTH_JWK_JSON=
AUTH_ALLOW_EPHEMERAL_JWK=false
AUTH_VITE_API_BASE_URL=http://192.168.1.10:3104
AUTH_VITE_K2S_BASE_URL=http://192.168.1.10:5173
AUTH_VITE_LOGBOOK_BASE_URL=http://192.168.1.10:5175
AUTH_VITE_K3_BASE_URL=http://192.168.1.10:3106
AUTH_VITE_KEAMANAN_BASE_URL=http://192.168.1.10:3107
AUTH_DB_NAME=sso_auth
AUTH_DB_USER=sso_auth
AUTH_DB_PASSWORD=change_me_auth
AUTH_DATABASE_URL=postgresql://sso_auth:change_me_auth@auth-db:5432/sso_auth
AUTH_AUDIENCE=k2s-platform
AUTH_DEFAULT_CLIENT_ID=k2s-web
AUTH_DEFAULT_CLIENT_SECRET=dev-secret-k2s
AUTH_DEFAULT_REDIRECT_URI=http://192.168.1.10:5173/auth/callback
AUTH_DEFAULT_POST_LOGOUT_URI=http://192.168.1.10:5173/login
AUTH_LOGBOOK_CLIENT_ID=logbook-web
AUTH_LOGBOOK_CLIENT_SECRET=dev-secret-logbook
AUTH_LOGBOOK_REDIRECT_URI=http://192.168.1.10:5175/auth/callback
AUTH_LOGBOOK_POST_LOGOUT_URI=http://192.168.1.10:5175/
AUTH_K3_CLIENT_ID=k3-web
AUTH_K3_CLIENT_SECRET=dev-secret-k3
AUTH_K3_REDIRECT_URI=http://192.168.1.10:3106/auth/callback
AUTH_K3_POST_LOGOUT_URI=http://192.168.1.10:3106/
AUTH_KEAMANAN_CLIENT_ID=keamanan-web
AUTH_KEAMANAN_CLIENT_SECRET=dev-secret-keamanan
AUTH_KEAMANAN_REDIRECT_URI=http://192.168.1.10:3107/auth/callback
AUTH_KEAMANAN_POST_LOGOUT_URI=http://192.168.1.10:3107/
AUTH_ALLOWED_ORIGINS=http://192.168.1.10:5173,http://192.168.1.10:5174,http://192.168.1.10:5175,http://192.168.1.10:3106,http://192.168.1.10:3107
AUTH_SESSION_COOKIE_SECURE=false
AUTH_DEV_ADMIN_USERNAME=admin
AUTH_DEV_ADMIN_EMAIL=admin@local.test
AUTH_DEV_ADMIN_PASSWORD=Admin123!

LOGBOOK_VITE_AUTH_PORTAL_URL=http://192.168.1.10:5174
LOGBOOK_VITE_API_BASE_URL=http://192.168.1.10:3105/api/v1
LOGBOOK_VITE_SSO_AUTH_BASE_URL=http://192.168.1.10:3104
LOGBOOK_VITE_SSO_AUTHORIZE_URL=http://192.168.1.10:3104/oauth/authorize
LOGBOOK_VITE_SSO_TOKEN_URL=http://192.168.1.10:3104/oauth/token
LOGBOOK_VITE_SSO_LOGOUT_URL=http://192.168.1.10:3104/auth/logout
LOGBOOK_VITE_SSO_CLIENT_ID=logbook-web
LOGBOOK_VITE_SSO_CLIENT_SECRET=dev-secret-logbook
LOGBOOK_VITE_SSO_REDIRECT_URI=http://192.168.1.10:5175/auth/callback
LOGBOOK_VITE_SSO_SCOPE=openid profile email
LOGBOOK_DB_NAME=logbook
LOGBOOK_DB_USER=logbook
LOGBOOK_DB_PASSWORD=change_me_logbook
LOGBOOK_DATABASE_URL=postgresql://logbook:change_me_logbook@logbook-db:5432/logbook?schema=public
LOGBOOK_CORS_ALLOW_ORIGINS=http://192.168.1.10:5174,http://192.168.1.10:5175
LOGBOOK_SSO_ISSUER=http://192.168.1.10:3104
LOGBOOK_SSO_AUDIENCE=k2s-platform
LOGBOOK_SSO_JWKS_URL=http://auth-backend:3104/.well-known/jwks.json
LOGBOOK_SSO_CLIENT_ID=logbook-web

K3_DB_NAME=k3_audit
K3_DB_USER=k3
K3_DB_PASSWORD=change_me_k3
K3_DATABASE_URL=postgresql://k3:change_me_k3@k3-db:5432/k3_audit?schema=public
K3_SSO_ISSUER=http://192.168.1.10:3104
K3_SSO_JWKS_URL=http://auth-backend:3104/.well-known/jwks.json
K3_SSO_AUDIENCE=k2s-platform
K3_GOOGLE_CLIENT_ID=
K3_GOOGLE_CLIENT_SECRET=
K3_GOOGLE_REDIRECT_URI=http://192.168.1.10:3106/api/google-drive/callback
K3_GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive
K3_GOOGLE_DRIVE_ROOT_FOLDER_ID=
K3_GOOGLE_DRIVE_ROOT_FOLDER_NAME=K3 Evidence
K3_FRONTEND_BASE_URL=http://192.168.1.10:3106

KEAMANAN_DB_NAME=keamanan
KEAMANAN_DB_USER=keamanan
KEAMANAN_DB_PASSWORD=change_me_keamanan
KEAMANAN_DATABASE_URL=postgresql://keamanan:change_me_keamanan@keamanan-db:5432/keamanan?schema=public
KEAMANAN_CORS_ALLOW_ORIGINS=http://192.168.1.10:3107,http://192.168.1.10:5174
KEAMANAN_ADMIN_ROLES=admin,keamanan_admin
KEAMANAN_SSO_ISSUER=http://192.168.1.10:3104
KEAMANAN_SSO_AUDIENCE=k2s-platform
KEAMANAN_SSO_JWKS_URL=http://auth-backend:3104/.well-known/jwks.json
KEAMANAN_SSO_AUTHORIZE_URL=http://192.168.1.10:3104/oauth/authorize
KEAMANAN_SSO_TOKEN_URL=http://192.168.1.10:3104/oauth/token
KEAMANAN_SSO_LOGOUT_URL=http://192.168.1.10:3104/auth/logout
KEAMANAN_SSO_SCOPE=openid profile email
KEAMANAN_SSO_CLOCK_SKEW=60
KEAMANAN_SSO_JWKS_CACHE_TTL=300
KEAMANAN_VITE_API_BASE_URL=http://192.168.1.10:3107/api
KEAMANAN_VITE_PORTAL_DASHBOARD_URL=http://192.168.1.10:5174
KEAMANAN_VITE_SSO_ENABLED=true

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=k2s
DB_USERNAME=k2s
DB_PASSWORD=k2s_password
DB_ROOT_PASSWORD=k2s_root_password

SESSION_DRIVER=cookie
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CORS_ALLOW_ORIGINS=http://192.168.1.10:5173,http://192.168.1.10:5174
SANCTUM_STATEFUL_DOMAINS=192.168.1.10:5173,192.168.1.10:5174
SANCTUM_EXPIRATION=1440
QUEUE_CONNECTION=database
SEED_ON_START=false

AUTH_MODE=sso
SSO_ISSUER=http://192.168.1.10:3104
SSO_AUDIENCE=k2s-platform
SSO_JWKS_URL=http://auth-backend:3104/.well-known/jwks.json
SSO_AUTHORIZE_URL=http://192.168.1.10:3104/oauth/authorize
SSO_TOKEN_URL=http://192.168.1.10:3104/oauth/token
SSO_END_SESSION_URL=http://192.168.1.10:3104/auth/logout
SSO_CLIENT_ID=k2s-web
SSO_SCOPE=openid profile email
SSO_CLOCK_SKEW=60
SSO_JWKS_CACHE_TTL=300
SSO_SUB_CLAIM=sub
SSO_EMAIL_CLAIM=email
SSO_USERNAME_CLAIM=preferred_username
SSO_NAME_CLAIM=name
SSO_ADMIN_ROLES=admin,k2s_admin
SSO_VIEWER_ROLES=user,viewer,k2s_user,k2s_viewer
SSO_EXTERNAL_DNP_ROLES=external_dnp,k2s_external_dnp
SSO_PROVISION_USERS=true

KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin123!
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_dev_password

LOG_CHANNEL=stderr
LOG_LEVEL=info
TRUSTED_PROXIES=*

EXTERNAL_DNP_WRAPPER_URL=http://wrapper:5001
EXTERNAL_DNP_WEB2_URL=http://180.214.246.148
EXTERNAL_DNP_WRAPPER_INTERNAL_TOKEN=change-me-internal-token
WRAPPER_SECRET_KEY=super_secret_key_web1
WRAPPER_DEBUG=false

WHATSAPP_API_SERVICE_URL=http://whatsapp-api:5002
WHATSAPP_BOT_HOST=0.0.0.0
WHATSAPP_BOT_PORT=5002
WHATSAPP_BOT_DEBUG=false
WHATSAPP_BOT_BACKEND_URL=http://backend-nginx
WHATSAPP_BOT_INTERNAL_TOKEN=change-me-whatsapp-bot-token
WHATSAPP_BOT_MAX_ITEMS=15
WHATSAPP_BOT_REQUEST_TIMEOUT=30
WHATSAPP_BOT_DEDUP_TTL=90
WHATSAPP_BOT_COMMAND_COOLDOWN=300
WAHA_API_BASE_URL=http://127.0.0.1:3000/
WAHA_API_KEY=
WAHA_SESSION_NAME=default
WAHA_WEBHOOK_SECRET=
