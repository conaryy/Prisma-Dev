// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Personnel {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  location            String
  documentPeriod      String?
  sourceDocument      String?
  licenseNumber       String?
  birthPlaceDate      String?
  address             String?
  maritalStatus       String?
  religion            String?
  status              PersonnelStatus @default(VALID)
  refreshmentExisting String?
  refreshmentPlan     String?
  recurrentExisting   String?
  recurrentPlan       String?
  photoFileName       String?
  photoStorageName    String?         @unique
  photoMimeType       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  educationHistories  EducationHistory[]
  workHistories       WorkHistory[]
  trainingHistories   TrainingHistory[]
}

model EducationHistory {
  id          String    @id @default(cuid())
  personnelId String
  value       String
  personnel   Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)
}

model WorkHistory {
  id          String    @id @default(cuid())
  personnelId String
  value       String
  personnel   Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)
}

model TrainingHistory {
  id          String    @id @default(cuid())
  personnelId String
  value       String
  personnel   Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)
}

model SecurityFacility {
  id              String         @id @default(cuid())
  slug            String         @unique
  name            String
  zone            String
  status          FacilityStatus @default(TERJADWAL)
  coveragePercent Int
  photoFileName   String?
  photoStorageName String?       @unique
  photoMimeType   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, updatedAt])
}

model SupervisionActivity {
  id             String                @id @default(cuid())
  slug           String                @unique
  title          String
  category       SupervisionCategory
  location       String?
  inspectorNames String[]
  scheduleLabel  String
  scheduleYear   Int
  scheduleMonth  Int?
  scheduleWeek   Int?
  sourceDocument String?
  status         SupervisionStatus     @default(BELUM_TERLAKSANA)
  completedAt    DateTime?
  completionNote String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  evidences      SupervisionEvidence[]

  @@index([category, scheduleYear, scheduleMonth, scheduleWeek])
}

model SupervisionEvidence {
  id           String              @id @default(cuid())
  activityId   String
  fileName     String
  storageName  String              @unique
  mimeType     String?
  sizeBytes    Int
  executionDate DateTime?
  uploadedAt   DateTime            @default(now())

  activity     SupervisionActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, executionDate, uploadedAt])
}

enum PersonnelStatus {
  VALID
  PERPANJANGAN
  PELATIHAN
}

enum FacilityStatus {
  OPTIMAL
  PERLU_SERVIS
  TERJADWAL
}

enum SupervisionCategory {
  AUDIT
  INSPEKSI
  TEST
}

enum SupervisionStatus {
  BELUM_TERLAKSANA
  TERLAKSANA
  PERLU_TINDAK_LANJUT
}
