<!DOCTYPE html>
<html
  lang="id"
  xmlns:o="urn:schemas-microsoft-com:office:office"
  xmlns:w="urn:schemas-microsoft-com:office:word"
  xmlns="http://www.w3.org/TR/REC-html40"
>
  <head>
    <meta charset="utf-8" />
    <title>Dokumen Rekap Fasilitas Keamanan</title>
    <!--[if gte mso 9]>
    <xml>
      <w:WordDocument>
        <w:View>Print</w:View>
        <w:Zoom>90</w:Zoom>
      </w:WordDocument>
    </xml>
    <![endif]-->
    <style>
      @page Section1 {
        size: 841.95pt 595.35pt;
        mso-page-orientation: landscape;
        margin: 1.2cm;
      }

      body {
        font-family: "Times New Roman", serif;
        margin: 0;
        color: #111111;
        font-size: 10.5pt;
      }
      div.Section1 {
        page: Section1;
      }
      .document-shell {
        width: 100%;
      }
      .document-header {
        margin-bottom: 18px;
        text-align: center;
      }
      .document-title {
        margin: 0;
        font-size: 22pt;
        font-weight: 700;
      }
      .document-organization {
        margin: 10px 0 0;
        font-size: 16pt;
        font-weight: 700;
        text-decoration: underline;
        text-decoration-color: #c1121f;
        text-underline-offset: 4px;
      }
      .document-subtitle {
        margin: 10px 0 0;
        font-size: 13pt;
        font-weight: 700;
      }
      .document-meta {
        margin: 0 0 14px;
        font-size: 10.5pt;
        line-height: 1.6;
      }
      .document-meta strong {
        display: inline-block;
        min-width: 140px;
      }
      .section-caption {
        margin: 0;
        padding: 8px 10px;
        border: 1px solid #b6bfce;
        border-bottom: 0;
        background: #f7f8fb;
        font-size: 11pt;
        font-weight: 700;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        border: 1px solid #b6bfce;
      }
      th,
      td {
        border: 1px solid #b6bfce;
        padding: 8px 9px;
        font-size: 9.5pt;
        vertical-align: top;
        word-break: break-word;
      }
      th {
        background: #dde2ea;
        text-align: left;
        font-weight: 700;
      }
      .col-no {
        width: 5%;
      }
      .col-name {
        width: 28%;
      }
      .col-location {
        width: 22%;
      }
      .col-status {
        width: 14%;
      }
      .col-coverage {
        width: 12%;
      }
      .col-updated {
        width: 19%;
      }
      .cell-center {
        text-align: center;
        vertical-align: middle;
      }
      .cell-strong {
        font-weight: 700;
      }
      tbody tr:nth-child(even) td {
        background: #fbfcfe;
      }
    </style>
  </head>
  <body>
    <div class="Section1 document-shell">
      <div class="document-header">
        <h1 class="document-title">Dokumen Rekap Fasilitas Keamanan</h1>
        <div class="document-organization">Perum LPPNPI Cabang Surabaya</div>
        <div class="document-subtitle">Status Perangkat Lapangan</div>
      </div>

      <div class="document-meta">
        <div><strong>Tanggal Export</strong>: 13 April 2026 pukul 15.02</div>
        <div><strong>Total Fasilitas</strong>: 7</div>
      </div>

      <p class="section-caption">Tabel Rekap Fasilitas Keamanan</p>
      <table>
        <thead>
          <tr><th class="col-no">No</th><th class="col-name">Fasilitas</th><th class="col-location">Zona</th><th class="col-status">Status</th><th class="col-coverage">Coverage</th><th class="col-updated">Pembaruan</th></tr>
        </thead>
        <tbody>
          <tr><td class="cell-center">1</td><td class="cell-strong">Pagar Perimeter Selatan</td><td class="">Zona Restricted</td><td class="cell-center">Terjadwal</td><td class="cell-center">88%</td><td class="">13 Apr 2026, 03.18</td></tr><tr><td class="cell-center">2</td><td class="cell-strong">X-Ray Checkpoint Utama</td><td class="">Terminal Kedatangan</td><td class="cell-center">Optimal</td><td class="cell-center">100%</td><td class="">13 Apr 2026, 03.18</td></tr><tr><td class="cell-center">3</td><td class="cell-strong">Access Gate Cargo</td><td class="">Zona Cargo</td><td class="cell-center">Perlu Servis</td><td class="cell-center">76%</td><td class="">13 Apr 2026, 03.18</td></tr><tr><td class="cell-center">4</td><td class="cell-strong">CCTV Perimeter Timur</td><td class="">Zona Airside</td><td class="cell-center">Optimal</td><td class="cell-center">98%</td><td class="">13 Apr 2026, 03.18</td></tr><tr><td class="cell-center">5</td><td class="cell-strong">apar3</td><td class="">airside</td><td class="cell-center">Optimal</td><td class="cell-center">100%</td><td class="">12 Apr 2026, 13.18</td></tr><tr><td class="cell-center">6</td><td class="cell-strong">apar</td><td class="">airside</td><td class="cell-center">Optimal</td><td class="cell-center">100%</td><td class="">12 Apr 2026, 12.11</td></tr><tr><td class="cell-center">7</td><td class="cell-strong">APAR</td><td class="">Koridor</td><td class="cell-center">Optimal</td><td class="cell-center">90%</td><td class="">12 Apr 2026, 12.02</td></tr>
        </tbody>
      </table>
    </div>
  </body>
</html>