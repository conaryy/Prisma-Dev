FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund

COPY . .
ARG VITE_API_BASE_URL
ARG VITE_SSO_AUTH_BASE_URL
ARG VITE_K2S_BASE_URL
ARG VITE_LOGBOOK_BASE_URL
ARG VITE_K3_BASE_URL
ARG VITE_KEAMANAN_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_SSO_AUTH_BASE_URL=${VITE_SSO_AUTH_BASE_URL}
ENV VITE_K2S_BASE_URL=${VITE_K2S_BASE_URL}
ENV VITE_LOGBOOK_BASE_URL=${VITE_LOGBOOK_BASE_URL}
ENV VITE_K3_BASE_URL=${VITE_K3_BASE_URL}
ENV VITE_KEAMANAN_BASE_URL=${VITE_KEAMANAN_BASE_URL}
RUN npm run build

FROM nginx:1.25-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx.auth.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
