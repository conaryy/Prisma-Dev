WAHA_API_KEY=
WAHA_SESSION_NAME=default
WAHA_WEBHOOK_SECRET=

# ============================================================
# Tambahan variabel yang sebelumnya belum didefinisikan di file
# localhost ini (menghilangkan warning "variable is not set"
# saat docker compose up dan melengkapi konfigurasi lokal).
# ============================================================

# --- Portal & SSO umum (dipakai frontend saat build) ---
AUTH_PORTAL_URL=http://localhost:5174
VITE_SSO_ENABLED=true
VITE_ALLOW_QUERY_TOKEN=false

# --- TTL token & sesi Auth service ---
AUTH_SESSION_TTL_SECONDS=28800
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_REFRESH_TOKEN_TTL_SECONDS=1209600

# --- Sync user Auth -> K2S backend (service-to-service) ---
# URL memakai nama service Docker karena request dilakukan dari
# dalam container auth-backend, bukan dari browser.
AUTH_K2S_USER_SYNC_URL=http://backend-nginx/api/internal/auth/users/sync
AUTH_K2S_USER_SYNC_TOKEN=

# --- OAuth client Keamanan (di-seed oleh Auth service) ---
AUTH_KEAMANAN_CLIENT_ID=keamanan-web
AUTH_KEAMANAN_CLIENT_SECRET=
AUTH_KEAMANAN_REDIRECT_URI=http://localhost:5177/auth/callback
AUTH_KEAMANAN_POST_LOGOUT_URI=http://localhost:5177/

# --- Service Keamanan ---
KEAMANAN_ADMIN_ROLES=admin,keamanan_admin
KEAMANAN_CORS_ALLOW_ORIGINS=http://localhost:5174,http://localhost:5177
KEAMANAN_VITE_SSO_ENABLED=true
KEAMANAN_VITE_API_BASE_URL=http://localhost:5177
KEAMANAN_VITE_PORTAL_DASHBOARD_URL=http://localhost:5177

# ISSUER harus sama dengan claim "iss" pada token (yaitu AUTH_ISSUER),
# sedangkan JWKS_URL di-fetch dari dalam container sehingga wajib
# memakai nama service Docker (auth-backend), bukan localhost.
KEAMANAN_SSO_ISSUER=http://localhost:3104
KEAMANAN_SSO_JWKS_URL=http://auth-backend:3104/.well-known/jwks.json
KEAMANAN_SSO_AUDIENCE=k2s-platform
KEAMANAN_SSO_SCOPE=openid profile email
KEAMANAN_SSO_CLOCK_SKEW=60
KEAMANAN_SSO_JWKS_CACHE_TTL=300

# URL berikut dipakai browser (redirect OAuth), jadi tetap localhost.
KEAMANAN_SSO_AUTHORIZE_URL=http://localhost:3104/oauth/authorize
KEAMANAN_SSO_TOKEN_URL=http://localhost:3104/oauth/token
KEAMANAN_SSO_LOGOUT_URL=http://localhost:3104/auth/logout

MINIO_ROOT_USER=k2sminioadmin
MINIO_ROOT_PASSWORD=

BUNDLE_S3_ACCESS_KEY=
BUNDLE_S3_SECRET_KEY=
