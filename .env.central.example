# Central deploy env (used by docker-compose.central.yml)

APP_NAME=K2S
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:REPLACE_WITH_php_artisan_key_generate_show

BACKEND_APP_URL=https://api.example.com
VITE_API_BASE_URL=https://api.example.com
AUTH_BASE_URL=https://auth.example.com
AUTH_ISSUER=https://auth.example.com
AUTH_LOGIN_UI_URL=https://auth.example.com/login
AUTH_VITE_API_BASE_URL=https://auth.example.com
AUTH_VITE_K2S_BASE_URL=https://k2s.example.com
AUTH_VITE_LOGBOOK_BASE_URL=https://logbook.example.com
AUTH_DB_NAME=sso_auth
AUTH_DB_USER=sso_auth
AUTH_DB_PASSWORD=change_me_auth
AUTH_DATABASE_URL=postgresql://sso_auth:change_me_auth@auth-db:5432/sso_auth
AUTH_AUDIENCE=k2s-platform
AUTH_DEFAULT_CLIENT_ID=k2s-web
AUTH_DEFAULT_CLIENT_SECRET=dev-secret-k2s
AUTH_DEFAULT_REDIRECT_URI=https://k2s.example.com/auth/callback
AUTH_DEFAULT_POST_LOGOUT_URI=https://k2s.example.com/login
AUTH_LOGBOOK_CLIENT_ID=logbook-web
AUTH_LOGBOOK_CLIENT_SECRET=dev-secret-logbook
AUTH_LOGBOOK_REDIRECT_URI=https://logbook.example.com/auth/callback
AUTH_LOGBOOK_POST_LOGOUT_URI=https://logbook.example.com/
AUTH_ALLOWED_ORIGINS=https://auth.example.com,https://k2s.example.com,https://logbook.example.com,https://k3.example.com,https://keamanan.example.com
AUTH_SESSION_COOKIE_SECURE=true
AUTH_DEV_ADMIN_USERNAME=admin
AUTH_DEV_ADMIN_EMAIL=admin@local.test
AUTH_DEV_ADMIN_PASSWORD=Admin123!
LOGBOOK_BACKEND_PORT=3100
LOGBOOK_VITE_API_BASE_URL=/api/v1
LOGBOOK_VITE_AUTH_PORTAL_URL=https://auth.example.com/login
LOGBOOK_DB_NAME=logbook
LOGBOOK_DB_USER=logbook
LOGBOOK_DB_PASSWORD=change_me_logbook
LOGBOOK_DATABASE_URL=postgresql://logbook:change_me_logbook@logbook-db:5432/logbook?schema=public

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=k2s
DB_USERNAME=k2s
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root

SESSION_DRIVER=cookie
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CORS_ALLOW_ORIGINS=https://k2s.example.com,https://auth.example.com
SANCTUM_STATEFUL_DOMAINS=k2s.example.com,auth.example.com
SANCTUM_EXPIRATION=1440
QUEUE_CONNECTION=database
SEED_ON_START=false

AUTH_MODE=local
SSO_ISSUER=
SSO_AUDIENCE=
SSO_JWKS_URL=
SSO_AUTHORIZE_URL=
SSO_TOKEN_URL=
SSO_END_SESSION_URL=
SSO_CLIENT_ID=
SSO_SCOPE=openid profile email
SSO_CLOCK_SKEW=60
SSO_JWKS_CACHE_TTL=300
SSO_SUB_CLAIM=sub
SSO_EMAIL_CLAIM=email
SSO_USERNAME_CLAIM=preferred_username
SSO_NAME_CLAIM=name
SSO_ADMIN_ROLES=admin,k2s_admin
SSO_VIEWER_ROLES=user,viewer,k2s_user,k2s_viewer
SSO_EXTERNAL_DNP_ROLES=external_dnp,k2s_external_dnp
SSO_PROVISION_USERS=false

# Local SSO (optional via compose profile sso-local)
# AUTH_MODE=hybrid
# SSO_ISSUER=http://localhost:8080/realms/prisma-dev
# SSO_AUDIENCE=prisma-auth
# SSO_JWKS_URL=http://localhost:8080/realms/prisma-dev/protocol/openid-connect/certs
# SSO_AUTHORIZE_URL=http://localhost:8080/realms/prisma-dev/protocol/openid-connect/auth
# SSO_TOKEN_URL=http://localhost:8080/realms/prisma-dev/protocol/openid-connect/token
# SSO_END_SESSION_URL=http://localhost:8080/realms/prisma-dev/protocol/openid-connect/logout
# SSO_CLIENT_ID=prisma-auth
# SSO_SCOPE=openid profile email

KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin123!
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_dev_password

LOG_CHANNEL=stderr
LOG_LEVEL=info
TRUSTED_PROXIES=*

EXTERNAL_DNP_WRAPPER_URL=http://wrapper:5000
EXTERNAL_DNP_WEB2_URL=http://180.214.246.148
EXTERNAL_DNP_WRAPPER_INTERNAL_TOKEN=change-me-internal-token
WRAPPER_SECRET_KEY=super_secret_key_web1
WRAPPER_DEBUG=false
