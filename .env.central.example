# Central deploy env (used by docker-compose.central.yml)

APP_NAME=K2S
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:REPLACE_WITH_php_artisan_key_generate_show

BACKEND_APP_URL=https://api.example.com
VITE_API_BASE_URL=https://api.example.com
AUTH_VITE_API_BASE_URL=https://api.example.com
AUTH_VITE_K2S_BASE_URL=https://k2s.example.com

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=k2s
DB_USERNAME=k2s
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root

SESSION_DRIVER=cookie
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CORS_ALLOW_ORIGINS=https://k2s.example.com,https://auth.example.com
SANCTUM_STATEFUL_DOMAINS=k2s.example.com,auth.example.com
SANCTUM_EXPIRATION=1440
QUEUE_CONNECTION=database
SEED_ON_START=false

AUTH_MODE=local
SSO_ISSUER=
SSO_AUDIENCE=
SSO_JWKS_URL=
SSO_AUTHORIZE_URL=
SSO_TOKEN_URL=
SSO_END_SESSION_URL=
SSO_CLIENT_ID=
SSO_SCOPE=openid profile email
SSO_CLOCK_SKEW=60
SSO_JWKS_CACHE_TTL=300
SSO_SUB_CLAIM=sub
SSO_EMAIL_CLAIM=email
SSO_USERNAME_CLAIM=preferred_username
SSO_NAME_CLAIM=name
SSO_ADMIN_ROLES=admin,k2s_admin
SSO_VIEWER_ROLES=user,viewer,k2s_user,k2s_viewer
SSO_EXTERNAL_DNP_ROLES=external_dnp,k2s_external_dnp
SSO_PROVISION_USERS=false

LOG_CHANNEL=stderr
LOG_LEVEL=info
TRUSTED_PROXIES=*

EXTERNAL_DNP_WRAPPER_URL=http://wrapper:5000
EXTERNAL_DNP_WEB2_URL=http://180.214.246.148
EXTERNAL_DNP_WRAPPER_INTERNAL_TOKEN=change-me-internal-token
WRAPPER_SECRET_KEY=super_secret_key_web1
WRAPPER_DEBUG=false
